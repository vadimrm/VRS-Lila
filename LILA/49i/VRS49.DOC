/*
                     Virtual Reality Shell Lila
                 (C) Vadim Madgazin, 1995, 1996

                      I. Ближайшие планы.

 -битмапы/панели/палитры
  -не фиксировать d3poz панели в одном углу панели:
   d3poz панели сделать произвольной точкой в плоскости панели, введя
   сдвиги odx, odz этой точки от левого нижнего угла панели, видимо в
   fix-единицах 1/flenx, 1/flenz панели.
   Т.е. середина панели будет иметь odx=odz=FIX05 !
  -вместо near таблицы градаций gradcol[яркости=0...63][256] лучше
   иметь набор из 64 mem-блоков far памяти для 256-байтных таблиц
   преобразования яркости цвета и массив из 64 номеров этих блоков,
   соответствующих номеру градации яркости;
   это позволит также вместе (или вместо) с яркостью иметь наборы
   таблиц для изменения цветности и др., а также менять количество
   наборов для экономии памяти!
  -параметры изменения цвета ввести в панель: можно к постоянной
   яркости панели consti добавить динамически изменяемую яркость,
   устанавливаемую разными AP как им требуется - напр. можно сделать
   временное изменение яркости панели, которая ближайшая к указке,
   но еще не выбрана...
  -режим освещения от внешней лампы пропорционально 1/(dx^2+dy^2);
  -в панель ввести номер и параметры битмапа при наблюдении панели
   с обратной стороны; флаг совпадения битмапов фронта и тыла...
  -битмапы и фон с буферами рельефа поверхности (профили толщины),
   яркости и др...
  -курсор на выбранной панели лучше превратить в карандаш или ручку
   с пером, фломастер и т.п. с регулируемым углом и высотой над ней,
   а нынешний карандаш в воздухе лучше превратить в классную указку,
   или руку человека/манипулятор робота...

 -картинки
  -AP-просмотра и преобразования картинок pp->lp:
   опция смены палитры на 504m со статистическим преобразованием
   слишком близких цветов...
  -формат name.lp (lila picture) файла:
   -версия lp-формата
   -формат битмапа, мода развертки
   -текстура битмапа (обычно в моде развертки 2)
   -формат панели ('круглый круг')
   -номер прозрачного цвета
   -рекоменуемый максимум мультипликации цветности
   -тип палитры: внешняя в p-файле или внутренняя
   -имя p-файла, стандартный pal504m.p-файл виртуальный!
   -формат палитры (для будущих hi-true color)
   -внутренняя палитра
   -рельеф...
  -формат name.p файла: 768 байт rgb-палитры;

typedef struct//заголовок lila picture файла...
{
char lila[4];//идентификатор "Лила"
int ver;//версия lp-формата, для этой структуры ver=0
int mode;//мода развертки текстуры
int lenx,lenz;//длина битмапа по горизонтали и вертикали;
//рекомендуемый z-множитель для панелей этого битмапа с
fix fmulz;//верными пропорциями картинки (круглость круга);
int syspal;//1=палитра текстуры 504m, возможно с коррекцией цветности,
//этот флаг позволит не использовать преобразование цветов в 504m при
//показе картинки, однако т.к. палитра в файле есть - при необходимос-
//ти можно либо делать преобр-е цветов, либо устанавливать системную
//палитру 504m прямо из файла для получения верной цветности картинки!
int tflag;//1=в текструре есть прозрачный цвет, 0=нет
int colt;//номер прозрачного цвета: 0...255
int conv_present;//0=conv[256] нет, 1=есть;
//далее идет тело lp-файла:
//byte текстура битмапа 1...64000 байт
//byte pal[768];
//byte conv[256];//таблица преобр-я цветов в 504m
} LPfile;

 -прикладные программы
  -AP перемещения наблюдателя:
   -отключение каждого движения по _отжатию_ соотв-й клавиши;
   -перейти от регулировки смещений к регулировкам скоростей смещений
    с учетом инерции, для устранения 'лестничного эффекта' в смещ-ях!
  -AP-дизайнер:
   -ставит в пространстве панели с нужными параметрами, выбирает их
    текстуры;
   -записывает на диск дизайн одного набора панелей и может прочесть;
   -если надо редактирует дизайн;
   -может вращать и перемещать (свою) систему координат дизайна;
  -компас !
  -уровни дальности земли, цвет ее может зависить от расстояния!
  -кучкование звезд: млечный путь/галактики/шаровые скопления...
  -луна, солнце, облака, снег, дождь...
  -тетрис (простой), пасьянс Solitare, Painter...

 -тело
  -маркер, фиксированная ориентированная по углам метка для мгновенной
   телепортации тела; много маркеров;

 -рендер
  -вернуться везде к моде развёртки битмапов номер 1 !
  -когда юзер переходит через очередной уровень 'земли' Zз=100*n метров
   (где n=0,+-1,+-2...) делать изменение Zз на 100 м против предыдущего
   (вверх|вниз: всегда ближе к юзеру) и изменение палитры цветов:
   напр. с цвета облаков (или льда) на цвет грунта/воды/зелени (или
   морского дна...); можно плавный проход уровня облаков...
  -градации яркости свыше 100%: часть массива градаций цвета должна
   работать на повышение !
  -фон не нужен, если есть хотябы 1 сплошная панель, кот. покрывает
   _весь_ экран;
  -если есть >=1 таких панелей, выбираем ту из них, которая имеет
   наименьшее удаление Ymimmax своей дальней видимой на экране грани,
   тогда ее нужно рендерить первой, а из остальных панелей рендерить
   только те, видимые части которых ближе Yminmax, и даже только те
   их части, которые не дальше Yminmax...
  -горизонтальные панели;
  -вместо near PEN-ram выделять far блок памяти размером до 64 кбайт,
   для рендера всегда выделять 1 блок, а для экрана > 32000 пикселей
   выделять 2 блока только для y-буфера !!! причем, моду развертки их
   сделать как у VRAM !!! это ускорит рендер (байтовый шаг PENbmp/ybuf
   совпадет, правда только при 2-х шаговом рендере - но можно рендер
   всегда делать 2-х шаговым...), ускорит вывод в VRAM и освободит
   32к до рендера и после вывода на VGA; свободные near 32к можно (?)
   превратитьв far или раскидать на различные far->near данные...

 -разное
  -можно сделать варианты fix-функций с округлением отрицательных
   чисел результата к нулю, а не к -бесконечности (это происходит
   из-за сдвига результата на 16 бит вправо), а сейчас пока это
   приводит к таким вот погрешностям:
   хотя fixmul(1,FIX1+1)=1, но fixmul(-1,FIX1+1)=-2 !!!
  -систему координат перевести из ресурса AP в ресурс панели !!!
  -можно упростить и ускорить Color504m() и др манипуляции с цветами:
   надо массив nnn[16][16][16] приспособить для получения номера
   цвета в палитре 504m без предварительной коррекции цветности:
   color=nnn[r/4][g/4][b/4] !!!
  -регулировка яркости и контраста физической палитры;
  -AP получает MSG так:
   рука берет из ящика с инструментами табличку с нужным мессагом для
   AP и вставляет ее в панель этой AP...
  -можно сделать ADDR_ALL=0, ADDR_VRS=1 введя в виток эти AP[0/1],
   что улучшит решение напр. таких вопросов:
   мессаги от VRS к VRS из системного мессагофильтра могут быть
   тут же отработаны в AP[1], а не дожидаться следующего витка...

 -клиппинг
  -если карандаш дальше чем макс. сдвиг вперед - то удара об него
   не будет и можно рендерить его не после клиппинга и т.о. _до_
   стеклянной панели!
  -взаимодействие подвижного и неподвижного юзера с панелями через
   упругость, массу, силу и проч. механику;
  -первая ступень клиппинга во всех направлениях - геометрическая
   остановка при пересечении панели в любом направлении;
  -вторая ступень - оптический клиппинг при перемещении вперед для
   просачивания через дырявые участки панелей;
  -для избежания влияния на клиппинг 'особых' панелей (типа карандаша)
   при наличии прозрачных (назовем их впредь несплошными) и стеклянных
   панелей надо:
   сначала делать геометрический клиппинг среди сплошных панелей,
   затем отбирать близкие несплошные панели и делать их грубый рендер
   (напр. грубее в 2x2 раза), только в y-буфер, по которому и делать
   оптический клиппинг; для клиппинга особые панели вообще исключать,
   а если нужно - оптический клиппинг можно применять не только вперёд,
   но и в другие стороны - если на каждую из них делать свой отдельный
   рендер для клиппинга; однако это может быть накладно, поэтому есть
   более удобный вариант - оптич. клиппинг делать только вперед, но
   чтобы не проходить боком или задом через все несплошные панели -
   при геометрическом клиппинге считать несплошные панели сплошными,
   если они не спереди;
   после клиппинга делать обычный рендер всех панелей, включая особые,
   причем сначала ренедерить все нестеклянные панели в произвольном
   порядке, а потом все стеклянные панели в порядке приближения к
   экрану, тогда наложение стекла на любую панель, в т.ч. на стекло
   будет выглядеть верно!

                      II. Перспектива.

  многопользовательский вариант со многими вложенными мирами:

  игрок
  -существует некоторый набор игроков с разными правами;
  -игрок в пассиве состоит из тела по образу человека;
  -конструкция игрока в активе определяется оснаской, присоединенной к
   частям тела игрока и другим снастям (перчатки, сапоги, вооружение) и
   аудиовизуальным оборудованием (видеокамера, видеомонитор), а также
   набором сил, подключенных к оснастке (от которого зависит напр. число
   степеней свободы перемещения руки в перчатке или ноги в сапоге);
  -перчатка позволяет руке двигаться;
  -сапог или ботинок позволяет двигаться ноге и/или телу, в последнем
   случае достаточно иметь одну скрепленную пару обувки или специальный
   пояс-двигатель тела;
  -видеокамера жестко укреплена на теле, либо на руке;
  -видеокамера означает, что то, что видит игрок, он может передавать
   на видеомонитор (расположенный в системном мире на спине игрока) и/или
   на другой выход данных (компорт, файл...);
   видеокамеру можно регулировать, в частности угол обзора, частоту
   кадров...
  -конструкция суперигрока (супервизора) имеется по умолчанию, если
   она не определена специально;
  -игрок может быть уничтожен/порожден, его тело/руки могут сменить
   внешний вид, даже до невидимости;
  -режим ведущей руки и ведомого тела:
   -ведущая рука двигается произвольно,
   -тело двигается относительно ведущей руки,
   -другая рука движется относительно тела;
  -режим ведущего тела и ведомых рук:
   -тело двигается произвольно,
   -руки двигаются относительно тела,
   -перемещения рук обычно ограничены ближайшей панелью и телом;

  сила
  -одна сила может размножаться в несколько (как напряжение);
  -разные силы могут складываться (как ток);
  -по системному хоткею силы суперигрока отключаются от их источников и
   эти источники могут быть использованы в других игроках;
  -одна сила это есть поток одномерных данных из одного источника ввода,
   в том числе из физического файла или виртуального компьютера, для
   кейборда это одна клавиша!

  spaces
  -существует одно системное (общее или просто) пространство (SS);
  -часть системного пространства может быть объявлена прикладным (AS),
   оставшаяся часть будет не-прикладным пространством (NAS);
  -разделение на spaces удобно для быстрого выбора нужного набора AP,
   экономии ресурсов и оптимизации по разным характеристикам: напр.
   возможны AS с фикс. палитрами битмапов (тогда весь мир будет в
   одной колоритной палитре), разными модами экрана (640x480x16)...
  -число прикладных пространств не ограничено;
  -прикладные пространства могут перекрываться;
  -прикладные пространства по отношению к общему имеют свои системы
   координат и коэффициенты масштабирования по трем осям;
   обычно прикладные миры будут мельче не-прикладного;
  -в каждом пространстве в зависимости от прав игрока для него действует
   свой набор фильтров, делающих (частично) невидимыми некоторые объекты
   этого и других пространств, по признаку положения (относительно оригина
   этого пространства или оригина игрока!) и типа объектов;
   если масштаб не мелкий, лучше из не-прикладного мира наблюдать часть
   прикладного мира только вблизи и относительно игрока;
  -на полностью невидимые объекты влияние игрока отсутствует;
  -игрок входя в прикладное пространство попадает в его систему координат
   и получает свои фильтры, а видеомонитор игрока остается у точки входа
   в это пространство, чтобы можно было наблюдать его игру 'снаружи', как
   видит сам игрок 'изнутри';
   интересно, что действие фильтров можно рассматривать как работу спец.
   AP...
  -суперигрок остается в общем пространстве, даже если он геометрически
   попадает в прикладное пространство, т.е. его перемещение и размеры не
   масштабируются, хотя он может влиять на прикладное пространство и
   возможно даже быть видимым из него;
  -суперигрок (или другой игрок с соответствующими правами) собирает
   конструкцию игрока из разных снастей, подключает к ним набор сил,
   помещает игрока в прикладное пространство (напр. если у того нет прав
   перемещаться в не-прикладном пространстве), причем выполняет эти
   действия в любое время, может отобрать снасти или силы прямо во время
   игры...
  -прикладные программы выполняются во всех прикладных пространствах,
   перекрывающих оригины этих программ;
  -переключение палитры, моды экрана, откл. двойного рендера - чисто
   технические приемы программы, улучшающие качество картинки при
   наблюдении супервизором за монитором игрока в максимально удобной
   позиции, когда остальные объекты не видимы...

  рендер
  -с учетом двойного рендера нужен также вариант рендера с разверткой
   dst битмапа по вертикали, как у src битмапа!
  -при рендере картинки можно экономить ресурсы с учетом условий
   видимости ее на экране физического дисплея, ограничивая площадь,
   разрешение и частоту кадров;

  клавиатура и мессаги
  -сделать несколько системных таблиц для выполнения различных действий
   по любому системному хоткею (или их комбинации);
   основной вид действий - генерация различных макросов (наборов MSG)
   системы в AP, номер которой зависит от хоткея (пример макроса - MSG
   подключения ввода, несколько MSG ввода клавиш, MSG отключения ввода),
   а также выполнение зависимых системных действий (напр. действительное
   изменение направления ввода по каждому соотв-му MSG)...
   благодаря этому можно будет напр. заставлять юзера сплясать небольшой
   танец по нажатию единственного системного хоткея...

  разное
  -можно попробовать написать код AP так, чтобы можно было им управлять
   одновременно несколькими игроками из одного или из разных миров, если
   одна и та же копия кода AP вызывается из них...
  -спецманипулятор: рука вставляется в ящик с дыркой спереди;
  -выход из прикл. мира в систему:
   выход всей погруженной части юзера из мира выполняется также просто
   как и 'выход' из индивидуальной AP:
   Esc/F10 с остановкой/фоновой работой мира;
   если мир остановлен, то на его дисплеях видны статические картины
   всех глаз мира с последними отрендеренными кадрами, с максимальным
   разрешением;
  -увеличение точности координат (и промеж-х результатов их вычисл-й)
   с 32 до 64 бит: 48.16 (или 40.24 ?) битные fix !
  -прямое использование верхней памяти при помощи dos-экстендера; 
  -виртуальная память на диске;
  -вертикальная и горизонтальная пара PEN, лучше при разрешении не
   хуже 640x400...480 !

                      III. Цитата

  ...И, может быть, в этом есть великий смысл: заставить нас по-
  верить в то, что мы не хуже машин, что мы все-таки превосходим
  свои же изобретения. "Они бродят и бродят вокруг, калечась и
  спотыкаясь - как слепые, ведомые слепцом", - давно уже говорили
  Упанишады (Мундака Упанишада I.2.8). Не пришло ли время напра-
  вить взор поверх всех наших игрушек и начать Игру ? Вместо того,
  чтобы копать лопатами, бульдозерами, евангелиями и нейтронами,
  давайте поднимем целину сознания и бросим То семя на ветры вре-
  мени, и пусть жизнь наконец начнется.

     Земнорожденные, покорные и Силе, и Судьбе,
     В бескрайнем мире жалкие авантюристы,
     О гномы - пленники юдоли человечьей,
     Доколь, как заведенный, вертеться будет разум ваш
     Вокруг ваших жалких "я", мизе'рных мелочей ?
     Ничтожность постоянная - не в этом ваше назначенье,
     Круженье тщетное - не для того вы созданы'...
     Ведь силы всемогущие сокрыты в каждой клеточке Природы.
     И жребий ваш велик, и он - пред вами...
     Та жизнь, которой вы живете, от вас скрывает ваш же свет.
                                            (Savitri, 29:370)

     Сатпрем. "Шри Ауробиндо, или Путешествие сознания".

                      IV. Общие положения.

  1.VRS Лила (Shell/System Lila) - многозадачная Оболочка Виртуальной
    Реальности, разрабатаваемая как DOS-задача для PC AT 386 и выше.
    Первоначально VRS однопользовательская с одним юзером, одним миром.
  2.VRS пишется на чистом СИ и ассемблере в критических по скорости
    участках кода.
  3.Прикладные задачи (AP) создаваются на любых языках и подключаются
    к VRS во время ее линковки или компиляции (в виде OBJ или исходных
    файлов на СИ), позже возможна разработка динамического загрузчика
    произвольных Lila-AP с диска из exe-кода Lila.
  4.Минимизируется зависимость VRS от любой физической аппаратуры PC.
    Время измеряется таймером IRQ0 с частотой 250...1000 Герц.
  5.Математическая база VRS - это 3D-алгоритмы визуализации:
    первоначально только вертикального битмапа (а-ля Wolf3D),
    затем горизонтального битмапа (Doom),
    и наконец битмапа произвольной ориентации (Descent)...
  6.Звук в VRS опционален, возможны следующие варианты для PC:
    -псевдозвук на спикер (меандр переменной частоты);
    -DAC звук на ковокс/ШИМ спикер, с использованием IRQ0 ~>=10 кГц,
     при этом измеритель времени остается в IRQ0;
    -DAC-звук на Sound Blaster в моно-DMA-моде;
    -программный синтезатор музыка->DAC-звук.
  7.VRS создается для отработки логических, интерфейсно-пользовательских,
    математических и философских концепций устройства кода программы и
    самого виртуального мира, проверки решений в области архитектуры,
    эргономики, дизайна и других.
    Лила может быть использована для демонстрационно-рекламного показа
    софта и любых других товаров массового спроса, для обмена информацией
    журнального и других типов, а также как сборник простейших утилит и
    компьютерных игр средней сложности.
  8.Важно:
   -возможный источник малых ошибок:
    сдвиг вправо отрицательных чисел вместо деления,
    (X>>N)!=(X/2^N) при X=-1...(-N+1), надо (|X|>>N)*sign(X) !
   -пиксели используются для обозначения точек любых битмапов, напр.:
    битмапов с текстурами панелей, битмапа экрана наблюдения PEN-bmp,
    псевдобитмапа дальности пикселей экрана (z-буфер)...
   -все пространственные величины измеряются в долях метра, учитывая
    что 1 пиксель текстуры при масштабировании битмапа в панель 1:1
    превращается ровно в 1 сантиметр, т.о. обычная картинка 320x200
    превращается в панель 320x200 см или x240 см при растяжении Z
    для круглости круга...
   -углы Lila измеряются в лидусах, 360 градусов=65536 лидусов,
    точность (шаг) угла 4 лидуса!
   -panel.fmulz ограничен 160 (fix) в рендере и 600...1000 еще где-то...

*/
